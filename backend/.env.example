# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ntanda_lms?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-very-strong-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="60m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank to use MOCK mode (logs to console instead of sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Leave blank to use MOCK mode (logs to console instead of sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Payment Gateways ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYSTACK_SECRET_KEY=sk_test_...
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_WEBHOOK_SECRET=your_custom_webhook_secret_hash

